# Staging environment (CAL-146). Same binary/schema as production, but its OWN
# managed backends and secrets — never shared with prod or dev. Set these in the
# platform secret store (Render/Vercel env), never in the repo. Boot fails fast
# if a required value is missing. See docs/environments.md.
CALIBER_ENV=staging
CALIBER_LOG_LEVEL=info

# Staging-only managed backends (not localhost).
CALIBER_DATABASE_URL=            # postgres://user:pass@<staging-db-host>:5432/caliber?sslmode=require
CALIBER_REDIS_URL=              # rediss://:pass@<staging-redis-host>:6379/0

# Staging API keys — separate credentials from production.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Staging JWT secret — >=32 bytes, unique to staging: openssl rand -base64 48
CALIBER_JWT_SECRET=

# Field-encryption key (CAL-117) — set it in staging too so PII is encrypted at
# rest like prod; base64-encoded 32-byte AES-256 key: openssl rand -base64 32
CALIBER_FIELD_ENCRYPTION_KEY=

# The staging/preview frontend origin(s).
CALIBER_CORS_ORIGINS=          # https://staging.projectcaliber.app

# Deployed build id (git sha) for trace/version correlation.
CALIBER_SERVICE_VERSION=

# Optional in staging: retention sweep, Loki shipping. See .env.example for the
# full list of tunables (rate limits, dashboard TTL, interview caps, LLM guards).
# CALIBER_RETENTION_WINDOW=8760h
# CALIBER_LOKI_URL=
