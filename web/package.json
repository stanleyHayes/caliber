{
  "name": "caliber-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Project Caliber — Talent Intelligence Platform frontend (React + Vite + MUI v9).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-search-console.js && node scripts/prerender.js && node scripts/verify-prerender.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:prerender": "node scripts/verify-prerender.js",
    "lighthouse": "lhci autorun",
    "lighthouse:ci": "lhci autorun"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.1.2",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/i18next": "^13.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tmp": "^0.2.3",
    "uuid": "^11.1.1"
  }
}
