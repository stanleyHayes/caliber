# Production environment (CAL-146). Same binary/schema as staging, with its OWN
# managed backends and secrets — never shared with staging or dev, never in the
# repo (platform secret store only). Production boot FAILS FAST when a required
# value is missing, when a secret is weak, or when an endpoint is local
# (ProdSafetyIssues). See docs/environments.md.
CALIBER_ENV=prod
CALIBER_LOG_LEVEL=info

# Production managed backends (never localhost). Prefer PITR/WAL archiving on the
# database (see docs/runbooks/backup-restore.md).
CALIBER_DATABASE_URL=          # postgres://user:pass@<prod-db-host>:5432/caliber?sslmode=require
CALIBER_REDIS_URL=            # rediss://:pass@<prod-redis-host>:6379/0

# Production API keys — distinct from staging/dev; rotate per the schedule in
# docs/runbooks/secret-rotation.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Production JWT secret — REQUIRED, >=32 bytes, unique: openssl rand -base64 48
# (no ephemeral dev fallback in prod).
CALIBER_JWT_SECRET=

# Field-encryption key — REQUIRED in prod (CAL-117): base64-encoded 32-byte
# AES-256 key encrypting candidate PII at rest (CV competencies, interview Q&A,
# location/intake, match/report evidence). Without it prod FAILS FAST rather than
# store plaintext. Generate: openssl rand -base64 32
CALIBER_FIELD_ENCRYPTION_KEY=
# Rotation only (comma-separated retiring keys the app still DECRYPTS with while
# migrating). Set during a key rotation, then run cmd/reencrypt and clear it.
# See docs/runbooks/key-rotation.md.
# CALIBER_FIELD_ENCRYPTION_KEY_PREVIOUS=

# Production frontend origin(s) — REQUIRED in prod (deny-by-default CORS).
CALIBER_CORS_ORIGINS=        # https://projectcaliber.app

# Deployed build id (git sha).
CALIBER_SERVICE_VERSION=

# Recommended in prod: daily retention sweep + centralized logging.
CALIBER_RETENTION_WINDOW=8760h
CALIBER_RETENTION_CRON=@daily
# CALIBER_LOKI_URL=https://<loki-host>/loki/api/v1/push

# See .env.example for the full list of tunables.
